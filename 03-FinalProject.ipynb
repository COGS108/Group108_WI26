    "import numpy as np\n",
    "\n",
    "df[\"log_funding\"] = np.log10(df[\"funding_per_student_2012\"])\n",
    "df[\"log_earnings\"] = np.log10(df[\"MD_EARN_WNE_P10\"])\n",
